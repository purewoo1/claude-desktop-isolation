#!/usr/bin/python3
"""Query the configured read-only cluster gateway."""
import json
import socket
import sys


def main():
    args = sys.argv[1:]
    if not args or args == ["--help"]:
        print("cluster-code hosts | <alias> <status|roots|repos|list|stat|read|log|list-commit|"
              "read-commit|list-worktree|read-worktree> [arguments]")
        return
    data = json.dumps(args).encode() + b"\n"
    if len(data) > 8192:
        sys.exit("Cluster request is too large.")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(25)
        connection.connect("/run/guard/cluster.sock")
        connection.sendall(data)
        with connection.makefile("rb") as reader:
            header = reader.readline(513)
            if header.startswith(b"ERR "):
                sys.exit(header[4:].decode(errors="replace").strip())
            if not header.startswith(b"OK "):
                sys.exit("Invalid cluster response.")
            size = int(header[3:].strip())
            if not 0 <= size <= 2 * 1024 * 1024:
                sys.exit("Invalid cluster response size.")
            result = reader.read(size)
            if len(result) != size:
                sys.exit("Incomplete cluster response.")
            sys.stdout.buffer.write(result)


try:
    main()
except (OSError, ValueError):
    sys.exit("Cluster gateway unavailable or returned an invalid response.")
